  },
  "cheatsheet": [
    { "name": "with open", "desc": "打开文件，用完自动关", "code": "with open(\"a.txt\", \"w\", encoding=\"utf-8\") as f:" },
    { "name": "模式 w", "desc": "写入，会清空原内容", "code": "open(f, \"w\")" },
    { "name": "模式 a", "desc": "追加，接在后面", "code": "open(f, \"a\")" },
    { "name": "encoding", "desc": "中文必须写 utf-8", "code": "encoding=\"utf-8\"" }
  ]
